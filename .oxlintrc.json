{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": ["packages/sail-headless-agent/**", "packages/sail-v2-web/**"],
  "overrides": [
    {
      "files": ["packages/sail-finance/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@finos/sail-one", "**/sail-one/**"],
                "message": "Shells must not import each other. Share via @finos/sail-theme or the platform, never shell-to-shell."
              },
              {
                "group": [
                  "@finos/fdc3",
                  "@finos/fdc3/*",
                  "@finos/sail-headless-agent",
                  "@finos/sail-headless-agent/*",
                  "@finos/sail-extension-fdc3",
                  "@finos/sail-extension-fdc3/*",
                  "@finos/sail-extension-fdc3-*"
                ],
                "message": "sail-finance must not import FDC3 packages. Load sail.fdc3 (and satellites) as runtime extensions only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/sail-extension/**", "packages/sail-extension-server/**", "extensions/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@finos/sail-one",
                  "@finos/sail-finance",
                  "@finos/fdc3-sail-web",
                  "**/sail-one/**",
                  "**/sail-finance/**",
                  "**/sail-v2-web/**"
                ],
                "message": "Extensions must not import a Sail shell. Share via @finos/sail-extension."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/sail-one/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@finos/sail-finance", "**/sail-finance/**"],
                "message": "Shells must not import each other. Share via @finos/sail-theme or the platform, never shell-to-shell."
              }
            ]
          }
        ]
      }
    }
  ]
}

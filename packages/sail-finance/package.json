{
  "name": "@finos/sail-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "predev": "npm run build -w @finos/sail-env -w @finos/sail-platform -w @finos/sail-platform-browser -w @finos/sail-extension",
    "dev": "vp dev",
    "format:fix": "vp fmt .",
    "format": "vp fmt --check .",
    "lint:fix": "vp lint . --fix",
    "lint": "vp lint .",
    "preview": "vp preview",
    "test:run": "vp test run",
    "test": "vp test",
    "test:e2e": "playwright test",
    "typecheck": "tsc",
    "boundary:fdc3": "! rg -i 'fdc3' src --glob '!**/node_modules/**' || (echo 'FDC3 references remain under packages/sail-finance/src — purge them' && exit 1)",
    "validate": "npm run typecheck && npm run lint && npm run format && npm run boundary:fdc3"
  },
  "dependencies": {
    "@finos/sail-env": "*",
    "@finos/sail-extension": "*",
    "@finos/sail-platform": "*",
    "@finos/sail-platform-browser": "*",
    "@finos/sail-theme": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview": "^4.7.1",
    "dockview-react": "^4.7.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.542.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.7",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "dockview-react": "^4.7.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@finos/sail-extension-server": "*",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^26.1.0",
    "vitest": "5.1.0"
  }
}

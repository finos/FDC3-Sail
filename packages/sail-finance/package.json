{
  "name": "@finos/sail-finance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "predev": "npm run build -w @finos/sail-browser-agent -w @finos/sail-platform",
    "dev": "vp dev",
    "apps": "fdc3-example-apps",
    "conformance-2.2": "npx --yes @robmoffat/fdc3-conformance@2.2.3-test.1",
    "conformance-3.0": "npx --yes @robmoffat/fdc3-conformance@3.0.0-test.0",
    "dev:apps:2.2": "concurrently -k -n sail,apps,conf -c blue,magenta,green \"npm run dev\" \"npm run apps\" \"npm run conformance-2.2\"",
    "dev:apps:3.0": "concurrently -k -n sail,apps,conf -c blue,magenta,green \"npm run dev\" \"npm run apps\" \"npm run conformance-3.0\"",
    "format:fix": "vp fmt .",
    "format": "vp fmt --check .",
    "lint:fix": "vp lint . --fix",
    "lint": "vp lint .",
    "preview": "vp preview",
    "test:run": "vp test run",
    "test": "vp test",
    "test:e2e": "playwright test",
    "typecheck": "tsc",
    "validate": "npm run typecheck && npm run lint && npm run format"
  },
  "dependencies": {
    "@finos/fdc3": "^2.2.3",
    "@finos/sail-browser-agent": "*",
    "@finos/sail-platform": "*",
    "@tailwindcss/vite": "^4.1.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview": "^4.7.1",
    "dockview-react": "^4.7.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.542.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.7",
    "zustand": "^5.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@finos/sail-theme": "*"
  },
  "peerDependencies": {
    "dockview-react": "^4.7.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0"
  }
}

{
  "name": "@finos/sail-extension-server",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Dev Vite host for one Sail extension",
  "license": "Apache-2.0",
  "homepage": "https://github.com/finos/FDC3-Sail",
  "repository": "github:finos/FDC3-Sail",
  "bugs": "https://github.com/finos/FDC3-Sail/issues",
  "bin": {
    "sail-extension-server": "./bin/sail-extension-server.mjs"
  },

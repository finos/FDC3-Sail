{
  "name": "@finos/fdc3-sail-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npx vp build",
    "dev": "npm run build -w @finos/fdc3-sail-common --prefix ../.. && nodemon -w src/server -x tsx src/server/main.ts  --trace-uncaught",
    "apps": "fdc3-example-apps",
    "conformance-2.2": "npx --yes @robmoffat/fdc3-conformance@2.2.3-test.1",
    "dev:apps": "concurrently -k -n sail,apps -c blue,magenta \"npm run dev\" \"npm run apps\"",
    "dev:apps:2.2": "concurrently -k -n sail,apps,conf -c blue,magenta,green \"SAIL_FDC3_VERSION=2.2 VITE_FDC3_VERSION=2.2 npm run dev\" \"npm run apps\" \"npm run conformance-2.2\"",
    "dev:apps:3.0": "concurrently -k -n sail,apps -c blue,magenta \"SAIL_FDC3_VERSION=3.0 VITE_FDC3_VERSION=3.0 npm run dev\" \"npm run apps\"",
    "prod": "pm2 start pm2.config.js"
  },
  "main": "src/server/main.js",
  "types": "src/server/main.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/express": "^4.17.15",
    "@types/node": "^20.9.3",
    "@types/react": "^18.2.79",
    "bun": "^1.4.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.9.1",
    "glob": "^10.3.10",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.1.6"
  },
  "dependencies": {
    "@finos/fdc3-context-v3": "npm:@finos/fdc3-context@3.0.0-beta.1",
    "@finos/fdc3-schema-v3": "npm:@finos/fdc3-schema@3.0.0-beta.1",
    "@finos/fdc3-standard-v3": "npm:@finos/fdc3-standard@3.0.0-beta.1",
    "@finos/fdc3-sail-common": "0.0.0",
    "@finos/sail-headless-agent": "0.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "color": "^5.0.3",
    "express": "^4.18.3",
    "gridstack": "^10.1.2",
    "pretty-print-json": "^3.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hooks": "^1.0.1",
    "react-widgets": "^5.8.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.5.0",
    "typescript": "^5.3.2",
    "uuid": "^14.0.2",
    "vite-express": "^0.22.1",
    "ws": "^8.18.0"
  }
}

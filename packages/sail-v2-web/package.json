{
  "name": "@finos/fdc3-sail-web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "clean": "rimraf dist",
    "build": "npx vp build",
    "dev": "npm run build -w @finos/sail-env -w @finos/sail-headless-agent -w @finos/fdc3-sail-common --prefix ../.. && tsx watch --include src/server src/server/main.ts --trace-uncaught",
    "apps": "fdc3-example-apps",
    "conformance-2.2": "npx --yes @robmoffat/fdc3-conformance@2.2.3-test.1",
    "conformance-3.0": "npx --yes @robmoffat/fdc3-conformance@3.0.0-beta.1",
    "dev:apps": "concurrently -k -n sail,apps -c blue,magenta \"npm run dev\" \"npm run apps\"",
    "dev:conformance:2.2": "concurrently -k -n sail,conf -c blue,green \"VITE_FDC3_DIRECTORY_URL=http://localhost:3001/directories/localhost-conformance.json VITE_AUTO_RESOLVE=1 npm run dev\" \"npm run conformance-2.2\"",
    "dev:conformance:3.0": "concurrently -k -n sail,conf -c blue,green \"VITE_FDC3_DIRECTORY_URL=http://localhost:3001/directories/localhost-conformance.json VITE_AUTO_RESOLVE=1 npm run dev\" \"npm run conformance-3.0\"",
    "prod": "pm2 start pm2.config.js"
  },
  "main": "src/server/main.js",
  "types": "src/server/main.d.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.9.3",
    "@types/react": "^18.2.79",
    "bun": "^1.4.4",
    "copyfiles": "^2.4.1",
    "pm2": "^7.1.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript-plugin-css-modules": "^5.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "dependencies": {
    "@finos/fdc3-context-v3": "npm:@finos/fdc3-context@3.0.0-beta.1",
    "@finos/fdc3-sail-common": "0.0.0",
    "@finos/fdc3-schema-v3": "npm:@finos/fdc3-schema@3.0.0-beta.1",
    "@finos/fdc3-standard-v3": "npm:@finos/fdc3-standard@3.0.0-beta.1",
    "@finos/sail-env": "*",
    "@finos/sail-headless-agent": "0.0.0",
    "@types/react-dom": "^18.2.25",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.2",
    "color": "^5.0.3",
    "express": "^5.3.0",
    "gridstack": "^10.1.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.2.0",
    "pretty-print-json": "^3.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hooks": "^1.0.1",
    "react-widgets": "^5.8.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uuid": "^14.0.3",
    "vite-express": "^0.22.1",
    "ws": "^8.22.2"
  }
}

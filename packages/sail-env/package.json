{
  "name": "@finos/sail-env",
  "version": "3.0.0-beta.1",
  "description": "Shared Sail host URL query and Vite env helpers (appId, fdc3Directory, auto-resolve, SAIL_MAX_FDC3_VERSION).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/finos/FDC3-Sail",
  "repository": "github:finos/FDC3-Sail",
  "bugs": "https://github.com/finos/FDC3-Sail/issues",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": "./vite.d.ts"
  },
  "files": [
    "dist",
    "vite.d.ts"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "lint": "vp lint ."
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}

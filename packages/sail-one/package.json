{
  "name": "@finos/sail-one",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "vp build",
    "predev": "npm run build -w @finos/sail-browser-agent -w @finos/sail-platform",
    "dev": "vp dev",
    "apps": "fdc3-example-apps",
    "conformance-2.2": "npx --yes @robmoffat/fdc3-conformance@2.2.3-test.1",
    "conformance-3.0": "npx --yes @robmoffat/fdc3-conformance@3.0.0-test.0",
    "dev:apps:2.2": "concurrently -k -n sail,apps,conf -c blue,magenta,green \"VITE_FDC3_VERSION=2.2 npm run dev\" \"npm run apps\" \"npm run conformance-2.2\"",
    "dev:apps:3.0": "concurrently -k -n sail,apps,conf -c blue,magenta,green \"VITE_FDC3_VERSION=3.0 npm run dev\" \"npm run apps\" \"npm run conformance-3.0\"",
    "preview": "vp preview",
    "format": "vp fmt --check .",
    "format:fix": "vp fmt .",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "test": "vp test",
    "test:run": "vp test run",
    "typecheck": "tsc",
    "validate": "npm run typecheck && npm run lint && npm run format"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "glob": "^10.3.10",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "dependencies": {
    "@finos/fdc3-context-v3": "npm:@finos/fdc3-context@3.0.0-beta.1",
    "@finos/fdc3-schema-v3": "npm:@finos/fdc3-schema@3.0.0-beta.1",
    "@finos/fdc3-standard-v3": "npm:@finos/fdc3-standard@3.0.0-beta.1",
    "@finos/sail-browser-agent": "*",
    "@finos/sail-platform": "*",
    "color": "^5.0.0",
    "gridstack": "^12.6.0",
    "lucide-react": "^0.542.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-widgets": "^5.8.6"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}

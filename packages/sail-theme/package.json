{
  "name": "@finos/sail-theme",
  "version": "3.0.0-beta.1",
  "description": "Sail brand design tokens and assets: framework-agnostic CSS custom properties, logos and fonts. Consumed by the shells and the docs site.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/finos/FDC3-Sail",
  "repository": "github:finos/FDC3-Sail",
  "bugs": "https://github.com/finos/FDC3-Sail/issues",
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./tailwind.css": "./tailwind.css",
    "./assets/*": "./assets/*",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "tokens.css",
    "tailwind.css",
    "assets",
    "fonts"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node -e \"process.exit(0)\""
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
